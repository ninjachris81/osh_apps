<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="com.osh.ui.area.AreaFragment.AreaOverlays" />

        <import type="android.view.View" />

        <variable
            name="areaData"
            type="com.osh.ui.area.AreaViewModel" />
    </data>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitCenter"
            android:src="@drawable/base_layout_dg" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <FrameLayout
                android:id="@+id/roomMDG"
                android:layout_width="469dp"
                android:layout_height="0dp"
                android:layout_marginTop="21dp"
                android:layout_marginStart="22dp"
                android:layout_marginBottom="21dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent">
            </FrameLayout>

            <FrameLayout
                android:id="@+id/roomBDG"
                android:layout_width="155dp"
                android:layout_height="240dp"
                android:layout_marginStart="20dp"
                app:layout_constraintStart_toEndOf="@id/roomMDG"
                app:layout_constraintTop_toTopOf="@id/roomMDG">
            </FrameLayout>

            <FrameLayout
                android:id="@+id/roomFDG"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="20dp"
                android:layout_marginStart="1dp"
                android:layout_marginBottom="0dp"
                android:layout_marginEnd="22dp"
                app:layout_constraintBottom_toBottomOf="@id/roomMDG"
                app:layout_constraintStart_toStartOf="@id/roomBDG"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/roomBDG">
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </FrameLayout>

</layout>